<Configuration>
  <ViewDefinitions>
    <View>
      <Name>default</Name>
      <ViewSelectedBy>
        <TypeName>psQuizResult</TypeName>
      </ViewSelectedBy>
      <GroupBy>
        <PropertyName>Path</PropertyName>
        <Label>Path</Label>
      </GroupBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Test</Label>
            <Width>30</Width>
            <Alignment>left</Alignment>
          </TableColumnHeader>
           <TableColumnHeader>
            <Label>Grade</Label>
            <Width>6</Width>
            <Alignment>Center</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Questions</Label>
            <Width>10</Width>
            <Alignment>right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Correct</Label>
            <Width>10</Width>
            <Alignment>right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>TestTime</Label>
            <Width>19</Width>
            <Alignment>right</Alignment>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>
                "{0} [{1}]" -f $_.test,$_.TestVersion
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                <!-- display a color coded grade-->
                if ($host.Name -match "code|console") {
                  [double]$grade = ($_.TotalCorrect/$_.TotalQuestions)*100
                  if ($grade -ge 75) {
                    <!--green-->
                    "`e[92m$($_.GPA)`e[0m"
                  }
                  elseif ($grade -ge 45) {
                    <!--yellow-->
                    "`e[93m$($_.GPA)`e[0m"
                  }
                  else {
                    <!--red-->
                    "`e[91m$($_.GPA)`e[0m"
                  }
                }
                else {
                    $_.GPA
                }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>TotalQuestions</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                <!-- display a color coded grade-->
                if ($host.Name -match "code|console") {
                  [double]$grade = ($_.TotalCorrect/$_.TotalQuestions)*100
                  if ($grade -ge 75) {
                    <!--green-->
                    "`e[92m$($_.TotalCorrect)`e[0m"
                  }
                  elseif ($grade -ge 45) {
                    <!--yellow-->
                    "`e[93m$($_.TotalCorrect)`e[0m"
                  }
                  else {
                    <!--red-->
                    "`e[91m$($_.TotalCorrect)`e[0m"
                  }
                }
                else {
                    $_.Correct
                }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  $_.TestTime.ToString("hh\:mm\:ss")
                </ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>